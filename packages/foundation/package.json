      "require": "./dist/index.cjs.js"
    }
  },
  "sideEffects": false,
  "author": "Zack MacTavish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackMacTavish/2025Portfolio.git"
  },
  "homepage": "https://mactavish.xyz",
  "bugs": {
    "url": "https://github.com/ZackMacTavish/2025Portfolio/issues"
  },
  "keywords": [
    "design-system",
    "styled-components",
    "grid",
    "seo",
    "cursor",
    "theme"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=6"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {},
